# Deterministic local prototype (default)
VITE_CONSOLE_DATA_MODE=fixture

# Read-only Console BFF mode for OK-159 / OK-158 integration
# VITE_CONSOLE_DATA_MODE=bff
# VITE_CONSOLE_BFF_URL=/api/console/v0

# Separate read-only BFF process (server-side values; never exposed to Vite)
OK_CONSOLE_BFF_HOST=127.0.0.1
OK_CONSOLE_BFF_PORT=8787

# Local/test-only. Keep disabled in shared or production environments.
OK_CONSOLE_BFF_ENABLE_FAILURE_INJECTION=false
