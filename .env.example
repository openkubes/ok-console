# Deterministic local prototype (default)
VITE_CONSOLE_DATA_MODE=fixture

# Read-only Console BFF mode for OK-159 / OK-158 integration
# VITE_CONSOLE_DATA_MODE=bff
# VITE_CONSOLE_BFF_URL=/api/console/v0

# Separate read-only BFF process (server-side values; never exposed to Vite)
OK_CONSOLE_BFF_HOST=127.0.0.1
OK_CONSOLE_BFF_PORT=8787

# Observed-state source. Fixture is the explicit local rollback mode.
OK_CONSOLE_OBSERVED_STATE_MODE=fixture
# OK_CONSOLE_OBSERVED_STATE_MODE=openkubes
# OK_CONSOLE_OBSERVED_STATE_URL=https://platform.example/api/console-observed-state/v0alpha1
OK_CONSOLE_OBSERVED_STATE_TIMEOUT_MS=5000
OK_CONSOLE_OBSERVED_STATE_STALE_AFTER_MS=300000

# Local/test-only. Keep disabled in shared or production environments.
OK_CONSOLE_BFF_ENABLE_FAILURE_INJECTION=false

# Session runtime. Disabled is the explicit prototype default; there is no
# automatic in-memory fallback. Secret values are read from mounted files.
OK_CONSOLE_SESSION_STORE_MODE=disabled
# OK_CONSOLE_SESSION_STORE_MODE=postgres
# OK_CONSOLE_ORIGIN=https://console.example
# OK_CONSOLE_ENVIRONMENT_ID=production
# OK_CONSOLE_SESSION_EPOCH=deployment-2026-08
# OK_CONSOLE_AUTHORIZATION_REVISION=rbac-2026-08-22
# OK_CONSOLE_POSTGRES_URL_FILE=/run/secrets/ok-console/postgres-url
# OK_CONSOLE_POSTGRES_CA_FILE=/run/secrets/ok-console/postgres-ca.pem
# OK_CONSOLE_SESSION_ENVELOPE_PRIMARY_KEY_ID=key-2026-08
# OK_CONSOLE_SESSION_ENVELOPE_KEYS_FILE=/run/secrets/ok-console/envelope-keys.json
# OK_CONSOLE_POSTGRES_POOL_MAX=10
# OK_CONSOLE_POSTGRES_CONNECT_TIMEOUT_MS=5000
# OK_CONSOLE_POSTGRES_IDLE_TIMEOUT_MS=30000
# OK_CONSOLE_POSTGRES_STATEMENT_TIMEOUT_MS=5000
# Local loopback development only; never enable for a remote database.
# OK_CONSOLE_POSTGRES_ALLOW_INSECURE_LOOPBACK=true
