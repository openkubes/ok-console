# Host-process-only development profile. Copy outside the repository; no secret values here.
NODE_ENV=development
OK_CONSOLE_PROFILE=ok-local
OK_CONSOLE_LOCAL_IDENTITY_ENABLED=true
OK_CONSOLE_LOCAL_IDENTITY_RECOVERY_ENABLED=false
OK_CONSOLE_BFF_HOST=127.0.0.1
OK_CONSOLE_BFF_PORT=8787
OK_CONSOLE_ORIGIN=https://127.0.0.1:8787
OK_CONSOLE_LOCAL_TLS_CERT_FILE=/absolute/private/console-cert.pem
OK_CONSOLE_LOCAL_TLS_KEY_FILE=/absolute/private/console-key.pem
OK_CONSOLE_LOCAL_TLS_CA_FILE=/absolute/private/local-ca.pem
OK_CONSOLE_SESSION_STORE_MODE=postgres
OK_CONSOLE_DEV_PROTOTYPE_ENABLED=false
OK_CONSOLE_BFF_ENABLE_FAILURE_INJECTION=false
OK_CONSOLE_ENVIRONMENT_ID=community-preview
OK_CONSOLE_TENANT_ID=platform
OK_CONSOLE_AUTHORIZATION_REVISION=local-mapping-1
OK_CONSOLE_SESSION_EPOCH=local-install-1
OK_CONSOLE_SESSION_ENVELOPE_PRIMARY_KEY_ID=local-key-1
OK_CONSOLE_SESSION_ENVELOPE_KEYS_FILE=/absolute/private/identity/keys.json
OK_CONSOLE_LOCAL_ACCESS_PEPPER_FILE=/absolute/private/identity/pepper
OK_CONSOLE_POSTGRES_URL_FILE=/absolute/private/database-url
OK_CONSOLE_POSTGRES_CA_FILE=/absolute/private/database-ca.pem
OK_CONSOLE_OBSERVED_STATE_MODE=fixture
OK_CONSOLE_OIDC_ENABLED=false
# Initial attended setup only. Change to disabled after initialization and restart.
OK_CONSOLE_LOCAL_ACCESS_MODE=bootstrap
OK_CONSOLE_LOCAL_ACCESS_ACCOUNTS_FILE=/absolute/private/identity/bootstrap.json
