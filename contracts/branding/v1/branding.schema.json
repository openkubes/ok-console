{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkubes.io/contracts/console/branding/v1/branding.schema.json",
  "title": "OpenKubes Console per-installation branding",
  "description": "One file per deployment (branding.json in OK_CONSOLE_BRANDING_DIR). Structural contract only; colour contrast and asset checks are enforced by bff/branding.mjs and bff/brandingRuntime.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "productName", "logo", "favicon", "colors"],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "asset": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}\\.(svg|png|webp|ico)$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  },
  "properties": {
    "schema": { "const": "openkubes.console.branding/v1" },
    "productName": { "$ref": "#/$defs/text", "maxLength": 40 },
    "productShortName": { "$ref": "#/$defs/text", "maxLength": 24 },
    "productTagline": { "$ref": "#/$defs/text", "maxLength": 32 },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "properties": {
        "file": { "$ref": "#/$defs/asset" },
        "alt": { "$ref": "#/$defs/text", "maxLength": 80 }
      }
    },
    "favicon": { "$ref": "#/$defs/asset" },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent"],
      "properties": {
        "primary": { "$ref": "#/$defs/color", "description": "Buttons, links, active navigation. White text on it needs at least 4.5:1." },
        "accent": { "$ref": "#/$defs/color", "description": "Login emphasis and navigation marker. Needs at least 4.5:1 on the derived dark login panel." }
      }
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kicker": { "$ref": "#/$defs/text", "maxLength": 48 },
        "headline": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/text", "maxLength": 32 } },
        "text": { "$ref": "#/$defs/text", "maxLength": 240 }
      }
    },
    "poweredBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/text", "maxLength": 40 } }
    }
  }
}
