{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "ok-console",
    "namespace": "openkubes-console",
    "labels": { "app.kubernetes.io/name": "ok-console" }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": { "app.kubernetes.io/name": "ok-console" },
    "ports": [{ "name": "http", "port": 8787, "targetPort": "http", "appProtocol": "http" }]
  }
}
