{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "ok-console-preview-ingress",
    "namespace": "openkubes-console",
    "labels": {
      "app.kubernetes.io/name": "ok-console",
      "openkubes.io/environment": "ok-shared-preview"
    }
  },
  "spec": {
    "podSelector": { "matchLabels": { "app.kubernetes.io/name": "ok-console" } },
    "policyTypes": ["Ingress"],
    "ingress": [{
      "from": [{
        "namespaceSelector": { "matchLabels": { "kubernetes.io/metadata.name": "openkubes-console" } }
      }],
      "ports": [{ "protocol": "TCP", "port": 8787 }]
    }]
  }
}
