{
  "name": "@openkubes/ok-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "dev:bff": "node --watch bff/server.mjs",
    "start:bff": "node bff/server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bff": "vitest run bff",
    "test:contract": "vitest run src/domain/presentationContract.test.ts",
    "test:deployment": "vitest run deploy/kubernetes/deployment.test.ts",
    "test:postgres": "vitest run bff/security/postgresSessionStore.integration.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "openid-client": "6.8.7",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
